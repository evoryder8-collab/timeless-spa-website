---
// The interactive map. Nothing third-party loads until the visitor taps "show map";
// then src/scripts/map.ts loads MapLibre with OpenFreeMap tiles and flies in from above Cologne.
import Icon from './Icon.astro';
import { site, fullAddress, directions, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
---
<div class="mapblock" data-map data-lng={site.lngLat[0]} data-lat={site.lngLat[1]} data-name={site.name} data-stone-spot="top-left">
  <div class="mapblock__canvas" data-map-canvas aria-label={de ? 'Karte: Timeless Spa in Köln-Ehrenfeld' : 'Map: Timeless Spa in Cologne-Ehrenfeld'} role="region"></div>

  <div class="mapblock__poster" data-map-poster>
    <svg class="mapblock__art" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="600" height="400" fill="#e3d6c5" />
      <path d="M-20 300 C 120 260, 210 330, 330 290 S 520 230, 640 270 L 640 420 L -20 420 Z" fill="#c9cdb8" />
      <g fill="none" stroke="#f6f1ea" stroke-linecap="round">
        <path d="M 330 -10 C 320 120, 345 230, 318 420" stroke-width="16" />
        <path d="M -10 150 C 160 170, 300 160, 610 120" stroke-width="10" />
        <path d="M 60 -10 L 250 420" stroke-width="6" />
        <path d="M 470 -10 C 440 140, 520 260, 470 420" stroke-width="6" />
        <path d="M -10 60 L 610 250" stroke-width="4" opacity=".8" />
        <path d="M -10 360 L 610 330" stroke-width="4" opacity=".8" />
      </g>
      <g fill="#d6c4ad">
        <rect x="350" y="40" width="70" height="44" rx="4" />
        <rect x="200" y="200" width="60" height="58" rx="4" />
        <rect x="380" y="180" width="54" height="40" rx="4" />
        <rect x="90" y="70" width="80" height="50" rx="4" />
        <rect x="500" y="40" width="70" height="60" rx="4" />
      </g>
    </svg>
    <span class="mapblock__pin" aria-hidden="true"><span></span></span>
    <div class="mapblock__cta">
      <button class="btn" type="button" data-map-load>
        <Icon name="pin" />{de ? 'Karte anzeigen' : 'Show map'}
      </button>
      <p>
        {de
          ? 'Beim Laden der Karte werden Kartendaten von OpenFreeMap abgerufen. Dabei wird Ihre IP-Adresse übertragen.'
          : 'Loading the map fetches map data from OpenFreeMap, which receives your IP address.'}
      </p>
    </div>
  </div>

  <div class="mapblock__bar">
    <div>
      <strong>{site.name}</strong>
      <span>{fullAddress}</span>
    </div>
    <button class="btn btn--small" type="button" data-directions data-sfx="click">
      <Icon name="nav" />{de ? 'Route planen' : 'Get directions'}
    </button>
  </div>

  <dialog class="directions" data-directions-sheet aria-labelledby="directions-title">
    <div class="directions__card">
      <p class="eyebrow">{de ? 'Route planen' : 'Get directions'}</p>
      <h3 id="directions-title">{site.name}</h3>
      <p>{fullAddress}</p>
      <a class="directions__btn" href={directions.google} target="_blank" rel="noopener">
        <span>Google Maps</span><Icon name="external" />
      </a>
      <a class="directions__btn" href={directions.apple} target="_blank" rel="noopener">
        <span>Apple Maps</span><Icon name="external" />
      </a>
      <button class="directions__cancel" type="button" data-directions-close>{de ? 'Abbrechen' : 'Cancel'}</button>
    </div>
  </dialog>
</div>

<style>
  .mapblock {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--sand-2);
    min-height: 460px;
    height: 100%;
    isolation: isolate;
  }
  .mapblock__canvas { position: absolute; inset: 0; }
  .mapblock__poster { position: absolute; inset: 0; display: grid; place-items: center; transition: opacity 1s var(--ease); }
  .mapblock.is-live .mapblock__poster { opacity: 0; pointer-events: none; }
  .mapblock__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .mapblock__pin {
    position: absolute;
    left: 57%;
    top: 26%;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--clay-deep);
    box-shadow: 0 0 0 6px rgb(181 112 79 / 0.25);
  }
  .mapblock__pin span {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--clay);
    animation: pin-pulse 2.6s ease-out infinite;
  }
  @keyframes pin-pulse { from { transform: scale(0.6); opacity: 1; } to { transform: scale(3.2); opacity: 0; } }
  .mapblock__cta {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 330px;
    margin-top: 40px;
    padding: 22px;
    border-radius: 20px;
    background: rgb(246 241 234 / 0.82);
    backdrop-filter: blur(8px);
    text-align: center;
  }
  .mapblock__cta p { margin: 0; font-size: 0.82rem; line-height: 1.5; color: var(--muted); }
  .mapblock__bar {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 12px 12px 20px;
    border-radius: 18px;
    background: rgb(246 241 234 / 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 16px 40px -20px rgb(42 33 27 / 0.5);
    font-size: 0.92rem;
  }
  .mapblock__bar strong, .mapblock__bar span { display: block; }
  .mapblock__bar span { color: var(--muted); }

  /* custom marker created by map.ts */
  .mapblock :global(.spa-marker) { position: relative; width: 26px; height: 26px; }
  .mapblock :global(.spa-marker__dot) {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #e8b896, var(--clay) 60%, var(--clay-deep));
    box-shadow: 0 0 0 5px rgb(246 241 234 / 0.9), 0 0 30px 8px rgb(181 112 79 / 0.55);
  }
  .mapblock :global(.spa-marker__ring) {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--clay);
    animation: pin-pulse 2.6s ease-out infinite;
  }
  .mapblock :global(.spa-marker__label) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 14px);
    transform: translateX(-50%);
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--espresso);
    color: var(--sand);
    font-family: var(--serif);
    font-size: 0.95rem;
    white-space: nowrap;
    box-shadow: 0 10px 24px -10px rgb(42 33 27 / 0.6);
  }
  .mapblock :global(.maplibregl-ctrl-attrib) { font-size: 10px; background: rgb(246 241 234 / 0.75); }

  .directions {
    width: min(400px, calc(100% - 24px));
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 24px;
    background: var(--linen);
    color: var(--ink);
    box-shadow: 0 40px 100px -30px rgb(42 33 27 / 0.6);
  }
  .directions::backdrop { background: rgb(42 33 27 / 0.4); backdrop-filter: blur(4px); }
  .directions[open] { animation: dir-in 0.5s var(--ease) both; }
  @keyframes dir-in { from { opacity: 0; transform: translateY(24px); } }
  .directions__card { padding: 28px; display: grid; gap: 10px; }
  .directions__card .eyebrow { margin-bottom: 4px; }
  .directions__card p:not(.eyebrow) { margin: 0 0 10px; color: var(--muted); }
  .directions__btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 54px;
    padding: 0 20px;
    border-radius: 16px;
    background: var(--sand);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s;
  }
  .directions__btn:hover { background: var(--sand-2); }
  .directions__btn :global(svg) { width: 18px; height: 18px; }
  .directions__cancel { margin-top: 6px; min-height: 46px; border: 0; background: none; color: var(--muted); cursor: pointer; }
</style>
