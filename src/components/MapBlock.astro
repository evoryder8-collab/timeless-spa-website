---
// The interactive map. Nothing third-party loads until the visitor taps "show map";
// then src/scripts/map.ts loads MapLibre with OpenFreeMap tiles and flies in from above Cologne.
import Icon from './Icon.astro';
import { site, fullAddress, directions, type Lang } from '../data/site';
import { GOOGLE_MAPS, APPLE } from '../lib/brand-marks';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
---
<div class="mapblock" data-map data-lng={site.lngLat[0]} data-lat={site.lngLat[1]} data-name={site.name} data-stone-spot="top-left">
  <div class="mapblock__canvas" data-map-canvas aria-label={de ? 'Karte: Timeless Spa in Köln-Ehrenfeld' : 'Map: Timeless Spa in Cologne-Ehrenfeld'} role="region"></div>

  <div class="mapblock__poster" data-map-poster>
    <div class="mapblock__cta">
      <button class="btn" type="button" data-map-load>
        <Icon name="nav" />{de ? 'Zum Timeless Spa fliegen' : 'Fly to Timeless Spa'}
      </button>
      <p>
        {de
          ? 'Startet die Karte: Dabei werden Kartendaten von OpenFreeMap und Satellitenbilder der NASA geladen und Ihre IP-Adresse wird übertragen.'
          : 'Starts the map, which loads map data from OpenFreeMap and satellite imagery from NASA and sends them your IP address.'}
      </p>
    </div>
  </div>

  <div class="mapblock__bar">
    <div>
      <strong>{site.name}</strong>
      <span>{fullAddress}</span>
    </div>
    <button class="btn btn--small" type="button" data-directions data-sfx="click">
      <Icon name="nav" />{de ? 'Route planen' : 'Get directions'}
    </button>
  </div>

  <dialog class="directions" data-directions-sheet aria-labelledby="directions-title">
    <div class="directions__card">
      <p class="eyebrow">{de ? 'Route planen' : 'Get directions'}</p>
      <h3 id="directions-title">{site.name}</h3>
      <p>{fullAddress}</p>
      <a class="directions__btn raised" href={directions.google} target="_blank" rel="noopener" data-sfx="click">
        <span class="directions__badge directions__badge--google" aria-hidden="true" set:html={GOOGLE_MAPS} />
        <span class="directions__name">Google Maps</span><Icon name="external" />
      </a>
      <a class="directions__btn raised" href={directions.apple} target="_blank" rel="noopener" data-sfx="click">
        <span class="directions__badge directions__badge--apple" aria-hidden="true" set:html={APPLE} />
        <span class="directions__name">Apple Maps</span><Icon name="external" />
      </a>
      <button class="directions__cancel" type="button" data-directions-close>{de ? 'Abbrechen' : 'Cancel'}</button>
    </div>
  </dialog>
</div>

<style>
  .mapblock {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--sand-2);
    min-height: 460px;
    height: 100%;
    isolation: isolate;
  }
  .mapblock__canvas { position: absolute; inset: 0; z-index: 1; }
  .mapblock { background: radial-gradient(120% 90% at 50% 40%, #1a1626 0%, #0b0a12 55%, #050409 100%); }
  .mapblock :global(.mapblock__space) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; transition: opacity 0.4s; }
  .mapblock__poster { z-index: 2; }
  .mapblock__poster { position: absolute; inset: 0; display: grid; place-items: end center; padding-bottom: 92px; }
  .mapblock.is-live .mapblock__poster { pointer-events: none; }
  .mapblock.is-live .mapblock__cta { opacity: 0; transform: translateY(12px); }
  .mapblock :global(.mapblock__globe) { position: absolute; inset: 0; width: 100%; height: 100%; }
  @keyframes pin-pulse { from { transform: scale(0.6); opacity: 1; } to { transform: scale(3.2); opacity: 0; } }
  .mapblock__cta {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 340px;
    margin: 0 16px;
    text-align: center;
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .mapblock__cta p { margin: 0; font-size: 0.74rem; line-height: 1.45; color: rgb(246 241 234 / 0.55); }
  .mapblock__bar {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 12px 12px 20px;
    border-radius: 18px;
    background: rgb(246 241 234 / 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 16px 40px -20px rgb(42 33 27 / 0.5);
    font-size: 0.92rem;
  }
  .mapblock__bar strong, .mapblock__bar span { display: block; }
  .mapblock__bar .btn { flex: none; white-space: nowrap; }
  .mapblock__bar span { color: var(--muted); }

  /* custom marker created by map.ts */
  .mapblock :global(.spa-marker) { position: relative; width: 26px; height: 26px; }
  .mapblock :global(.spa-marker__dot) {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #e8b896, var(--clay) 60%, var(--clay-deep));
    box-shadow: 0 0 0 5px rgb(246 241 234 / 0.9), 0 0 30px 8px rgb(181 112 79 / 0.55);
  }
  .mapblock :global(.spa-marker__ring) {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--clay);
    animation: pin-pulse 2.6s ease-out infinite;
  }
  .mapblock :global(.spa-marker__label) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 14px);
    transform: translateX(-50%);
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--espresso);
    color: var(--sand);
    font-family: var(--serif);
    font-size: 0.95rem;
    white-space: nowrap;
    box-shadow: 0 10px 24px -10px rgb(42 33 27 / 0.6);
  }
  .mapblock :global(.maplibregl-ctrl-attrib) { font-size: 10px; background: rgb(246 241 234 / 0.75); }

  .directions {
    width: min(400px, calc(100% - 24px));
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 24px;
    background: var(--linen);
    color: var(--ink);
    box-shadow: 0 40px 100px -30px rgb(42 33 27 / 0.6);
  }
  .directions::backdrop { background: rgb(42 33 27 / 0.4); backdrop-filter: blur(4px); }
  .directions[open] { animation: dir-in 0.5s var(--ease) both; }
  @keyframes dir-in { from { opacity: 0; transform: translateY(24px); } }
  .directions__card { padding: 28px; display: grid; gap: 10px; }
  .directions__card .eyebrow { margin-bottom: 4px; }
  .directions__card p:not(.eyebrow) { margin: 0 0 10px; color: var(--muted); }
  .directions__btn {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 0 18px 0 12px;
    border-radius: 18px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.5s var(--ease);
  }
  .directions__btn:hover { transform: translateY(-2px); }
  .directions__btn:active { transform: scale(0.98); }
  .directions__name { flex: 1; }
  .directions__btn > :global(svg) { width: 18px; height: 18px; opacity: 0.55; }
  /* app-icon tiles carrying the real marks */
  .directions__badge { display: grid; place-items: center; width: 42px; height: 42px; flex: none; border-radius: 11px; }
  .directions__badge :global(svg) { display: block; }
  .directions__badge--google { background: #fff; box-shadow: 0 0 0 1px rgb(42 33 27 / 0.08), 0 4px 10px rgb(42 33 27 / 0.18); }
  .directions__badge--google :global(svg) { height: 26px; width: auto; }
  .directions__badge--apple { color: #fff; background: linear-gradient(180deg, #2c2c2e, #000); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16), 0 4px 10px rgb(0 0 0 / 0.3); }
  .directions__badge--apple :global(svg) { height: 22px; width: auto; margin-top: -2px; }
  .directions__cancel { margin-top: 6px; min-height: 46px; border: 0; background: none; color: var(--muted); cursor: pointer; }
</style>
