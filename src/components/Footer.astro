---
import Logo from './Logo.astro';
import Hours from './Hours.astro';
import { ui } from '../i18n/ui';
import { href, navPages } from '../i18n/routes';
import { site, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---
<footer class="site-footer" data-dust>
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Logo />
      <p>{t.footer.tagline}</p>
      <address>
        {site.address.street}<br />
        {site.address.zip} {site.address.city}-{site.address.district}
      </address>
    </div>
    <div>
      <h2 class="site-footer__label">{t.footer.explore}</h2>
      <ul>
        {navPages.map((p) => <li><a href={href(p, lang)}>{t.nav[p]}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="site-footer__label">{t.footer.contact}</h2>
      <ul>
        <li><a href={site.phone.href}>{site.phone.display}</a></li>
        <li><a href={site.whatsapp.href} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="site-footer__label">{t.hours}</h2>
      <Hours lang={lang} compact />
    </div>
  </div>
  <div class="wrap site-footer__base">
    <span>© {year} Timeless Spa</span>
    <span class="site-footer__legal">
      <a href={href('imprint', lang)}>{t.nav.imprint}</a>
      <a href={href('privacy', lang)}>{t.nav.privacy}</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: clamp(64px, 9vw, 110px) 0 calc(40px + env(safe-area-inset-bottom));
    background: var(--espresso);
    color: rgb(237 228 216 / 0.78);
    font-size: 0.97rem;
    --logo-accent: var(--clay-soft);
  }
  .site-footer :global(.logo) { color: var(--sand); }
  .site-footer :global(.logo__mark) { animation: mark-breathe 8s ease-in-out infinite; transform-origin: 50% 80%; }
  @keyframes mark-breathe { 0%, 100% { transform: scale(0.96); filter: drop-shadow(0 0 0 rgb(217 164 127 / 0)); } 50% { transform: scale(1.04); filter: drop-shadow(0 0 10px rgb(217 164 127 / 0.55)); } }
  .site-footer::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(217 164 127 / 0.9), transparent);
    background-size: 40% 100%;
    background-repeat: no-repeat;
    animation: edge-light 7s ease-in-out infinite;
  }
  @keyframes edge-light { from { background-position: -40% 0; } to { background-position: 140% 0; } }
  .site-footer > .wrap { position: relative; z-index: 1; }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.1fr 1.3fr;
    gap: 40px;
  }
  .site-footer__brand p { margin: 18px 0 10px; }
  .site-footer address { font-style: normal; }
  .site-footer__label {
    margin-bottom: 16px;
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clay-soft);
  }
  .site-footer ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .site-footer a { text-decoration: none; transition: color 0.3s; }
  .site-footer a:hover { color: var(--linen); }
  .site-footer__base {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid rgb(237 228 216 / 0.14);
    font-size: 0.88rem;
  }
  .site-footer__legal { display: flex; gap: 22px; }
  @media (max-width: 900px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 1140px) {
    .site-footer { padding-bottom: calc(110px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 520px) {
    .site-footer__grid { grid-template-columns: 1fr; }
    .site-footer__base { flex-direction: column; }
  }
</style>
