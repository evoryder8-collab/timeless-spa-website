---
// The gift voucher drawn in CSS 3D. src/scripts/voucher.ts tilts it towards the pointer.
import type { Lang } from '../data/site';

interface Props { lang: Lang; size?: 'large' | 'small' }
const { lang, size = 'large' } = Astro.props;
const de = lang === 'de';
---
<div class:list={['voucher', `voucher--${size}`]} data-voucher data-stone-spot="top-right">
  <div class="voucher__card" data-voucher-card>
    <div class="voucher__face">
      <div class="voucher__top">
        <span class="voucher__brand">Timeless<span>Spa</span></span>
        <svg class="voucher__mark" viewBox="0 0 40 40" aria-hidden="true">
          <ellipse cx="20" cy="31.5" rx="14" ry="6" fill="currentColor" />
          <ellipse cx="19" cy="21.2" rx="10" ry="4.6" fill="currentColor" transform="rotate(-6 19 21.2)" />
          <ellipse cx="20.5" cy="12.6" rx="6.4" ry="3.6" fill="currentColor" transform="rotate(5 20.5 12.6)" />
        </svg>
      </div>
      <div class="voucher__title">{de ? 'Gutschein' : 'Gift voucher'}</div>
      <div class="voucher__bottom">
        <span>{de ? 'Geschenkte Zeit' : 'The gift of time'}</span>
        <span class="voucher__no">Nº 0001</span>
      </div>
    </div>
    <span class="voucher__sheen" aria-hidden="true"></span>
  </div>
  <div class="voucher__shadow" aria-hidden="true"></div>
</div>

<style>
  .voucher { position: relative; perspective: 1100px; width: 100%; max-width: 520px; margin-inline: auto; container-type: inline-size; }
  .voucher--small { max-width: 380px; }
  .voucher__card {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 30%;
    position: relative;
    aspect-ratio: 1.62;
    border-radius: 22px;
    background:
      radial-gradient(120% 90% at 0% 0%, #c98a68 0%, transparent 55%),
      linear-gradient(135deg, #b5704f 0%, #96553a 55%, #7d4630 100%);
    color: #f6e9dc;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    box-shadow: inset 0 0 0 1px rgb(255 240 225 / 0.18), 0 1px 0 rgb(255 255 255 / 0.15) inset;
    overflow: hidden;
    transition: transform 0.8s var(--ease);
    will-change: transform;
  }
  .voucher__card.is-live { transition: transform 0.12s linear; }
  .voucher__card::before {
    /* fine linen weave */
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    opacity: 0.5;
    mix-blend-mode: soft-light;
  }
  .voucher__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8% 8% 7%;
    transform: translateZ(30px);
  }
  .voucher__top { display: flex; justify-content: space-between; align-items: flex-start; }
  .voucher__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--serif);
    font-size: clamp(1rem, 3.4cqi, 1.35rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .voucher__brand span { font-family: var(--sans); font-size: 0.55em; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; }
  .voucher__mark { width: 15%; max-width: 54px; opacity: 0.9; }
  .voucher__title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 330;
    font-size: clamp(2.2rem, 8vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 1px 0 rgb(0 0 0 / 0.12);
  }
  .voucher--small .voucher__title { font-size: clamp(2rem, 6vw, 2.8rem); }
  .voucher__bottom {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .voucher__sheen {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at var(--mx) var(--my), rgb(255 236 214 / 0.45), transparent 70%);
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .voucher__shadow {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -8%;
    height: 18%;
    border-radius: 50%;
    background: rgb(42 33 27 / 0.45);
    filter: blur(24px);
    z-index: -1;
  }
</style>
