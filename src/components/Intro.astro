---
// The first visit in a tab: (1) sound, (2) language with a five-second suggestion from the browser's language.
// It is visible only when the inline script in Base.astro adds `show-intro` to <html> (or once src/scripts/intro.ts
// marks it open). It persists across the language switch so the sound keeps playing and the reveal continues.
import Logo from './Logo.astro';
import { href, type PageKey } from '../i18n/routes';
import type { Lang } from '../data/site';

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;

const text = {
  de: {
    welcome: 'Willkommen bei Timeless Spa',
    soundTitle: 'Mit Klang erleben?',
    soundText: 'Wasser, Klangschalen und Stille begleiten Sie durch die Seite. Am schönsten mit Kopfhörern.',
    yes: 'Ja, mit Klang',
    recommended: 'Empfohlen',
    no: 'Nein, ohne Klang',
    langTitle: 'Sprache wählen',
    countdown: 'Deutsch wird gleich gewählt',
    paused: 'Automatische Auswahl pausiert',
    pause: 'Pausieren',
    resume: 'Fortsetzen',
    inhale: 'Einatmen',
    exhale: 'Ausatmen',
  },
  en: {
    welcome: 'Welcome to Timeless Spa',
    soundTitle: 'Experience it with sound?',
    soundText: 'Water, singing bowls and stillness accompany you through the site. Best with headphones.',
    yes: 'Yes, with sound',
    recommended: 'Recommended',
    no: 'No, without sound',
    langTitle: 'Choose your language',
    countdown: 'Continuing in English shortly',
    paused: 'Automatic selection paused',
    pause: 'Pause',
    resume: 'Resume',
    inhale: 'Breathe in',
    exhale: 'Breathe out',
  },
};
const t = text[lang];
---
<div class="intro" data-intro data-lang={lang} data-text={JSON.stringify(text)} role="dialog" aria-modal="true" aria-labelledby="intro-title" transition:persist="intro">
  <canvas class="intro__sparks" data-intro-sparks aria-hidden="true"></canvas>
  <div class="intro__glow" data-intro-glow aria-hidden="true"></div>

  <div class="intro__inner">
    <Logo class="intro__logo" />

    <div class="intro__breath" aria-hidden="true">
      <span class="intro__ring"></span>
      <span class="intro__ring intro__ring--late"></span>
      <span class="intro__circle" data-intro-circle></span>
      <span class="intro__word" data-intro-word data-t="inhale">{t.inhale}</span>
    </div>

    <section class="intro__step" data-intro-step="sound">
      <p class="intro__eyebrow" data-t="welcome">{t.welcome}</p>
      <h2 class="intro__title" id="intro-title" data-t="soundTitle">{t.soundTitle}</h2>
      <p class="intro__text" data-t="soundText">{t.soundText}</p>
      <div class="intro__sound">
        <div class="intro__yes-wrap">
          <button class="btn intro__yes" type="button" data-intro-sound="on">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /><path d="M18.5 5.5a9 9 0 0 1 0 13" /></svg>
            <span data-t="yes">{t.yes}</span>
          </button>
          <small class="intro__badge" data-t="recommended">{t.recommended}</small>
        </div>
        <button class="intro__no" type="button" data-intro-sound="off" data-t="no">{t.no}</button>
      </div>
    </section>

    <section class="intro__step" data-intro-step="lang" hidden>
      <h2 class="intro__title" data-intro-lang-title data-t="langTitle">{t.langTitle}</h2>
      <div class="intro__langs" role="group" aria-labelledby="intro-title">
        {(['de', 'en'] as const).map((l) => (
          <a class="intro__lang raised" href={href(page, l)} data-intro-pick={l} lang={l} hreflang={l} data-astro-prefetch="false">
            <span class="intro__flag">
              {l === 'de' ? (
                <svg viewBox="0 0 30 30" aria-hidden="true"><rect width="30" height="10" fill="#1d1a18" /><rect y="10" width="30" height="10" fill="#c8312b" /><rect y="20" width="30" height="10" fill="#f1c232" /></svg>
              ) : (
                <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><clipPath id="uk-t"><path d="M30 15h30v15zv15H0zH0V0zV0h30z" /></clipPath><rect width="60" height="30" fill="#012169" /><path d="M0 0l60 30M60 0L0 30" stroke="#fff" stroke-width="6" /><path d="M0 0l60 30M60 0L0 30" clip-path="url(#uk-t)" stroke="#c8102e" stroke-width="4" /><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" /><path d="M30 0v30M0 15h60" stroke="#c8102e" stroke-width="6" /></svg>
              )}
              <svg class="intro__progress" viewBox="0 0 50 50" aria-hidden="true"><circle cx="25" cy="25" r="23" pathLength="1" /></svg>
            </span>
            <span class="intro__lang-name">{l === 'de' ? 'Deutsch' : 'English'}</span>
            <svg class="intro__lang-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        ))}
      </div>
      <div class="intro__countdown" data-intro-countdown hidden>
        <span class="intro__seconds" data-intro-seconds aria-hidden="true">5</span>
        <span class="intro__countdown-label" data-intro-countdown-label role="status"></span>
        <button type="button" class="intro__pause" data-intro-pause aria-pressed="false"></button>
      </div>
    </section>
  </div>
</div>

<style>
  .intro { display: none; }
  :global(html.show-intro) .intro,
  .intro[data-open] {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    background: radial-gradient(120% 80% at 50% 40%, #f3ebdf 0%, var(--sand) 55%, #e2d3bf 100%);
    overflow: hidden;
  }
  .intro__sparks { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .intro__glow {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 140vmax;
    height: 140vmax;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(217 164 127 / 0.5) 0%, rgb(217 164 127 / 0.16) 28%, transparent 58%);
    transform: translate(-50%, -50%) scale(0.6);
    pointer-events: none;
  }
  .intro__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(18px, 3vh, 28px);
    width: min(100% - 40px, 520px);
    padding: 24px 0 calc(24px + env(safe-area-inset-bottom));
    text-align: center;
  }
  .intro__inner :global(.logo__text) { font-size: 1.7rem; }
  .intro__inner :global(.logo__mark) { width: 38px; height: 38px; }

  /* the breathing stone of light, with ripples that spread on every breath */
  .intro__breath { position: relative; display: grid; place-items: center; width: clamp(150px, 26vh, 260px); aspect-ratio: 1; transition: width 1s var(--ease); }
  .intro[data-step='lang'] .intro__breath { width: clamp(96px, 15vh, 130px); }
  .intro__circle {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 34% 28%, rgb(255 244 230 / 0.85), transparent 30%),
      radial-gradient(circle at 40% 35%, #e8b896, var(--clay) 62%, var(--clay-deep));
    box-shadow: 0 0 90px 14px rgb(181 112 79 / 0.35), inset 0 -12px 30px rgb(42 33 27 / 0.28), inset 0 6px 16px rgb(255 240 225 / 0.35);
    transform: scale(0.64);
    animation: breathe 8s ease-in-out infinite;
  }
  .intro__ring {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    border: 1.5px solid rgb(181 112 79 / 0.45);
    animation: ripple 8s ease-out infinite;
    opacity: 0;
  }
  .intro__ring--late { animation-delay: 4s; }
  .intro__word {
    position: relative;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.05rem, 2.4vh, 1.3rem);
    color: var(--linen);
    text-shadow: 0 1px 6px rgb(42 33 27 / 0.35);
  }
  @keyframes breathe { 0%, 100% { transform: scale(0.64); } 50% { transform: scale(1); } }
  @keyframes ripple { 0% { transform: scale(0.8); opacity: 0; } 8% { opacity: 0.9; } 60% { transform: scale(2.2); opacity: 0; } 100% { opacity: 0; } }

  .intro__step { display: grid; justify-items: center; gap: 14px; }
  .intro__step[hidden] { display: none; }
  .intro__eyebrow { margin: 0; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--olive-deep); }
  .intro__title { font-size: clamp(2rem, 3vw + 1rem, 3.6rem); }
  .intro__text { max-width: 30em; margin: 0; color: var(--muted); }

  .intro__sound { display: grid; justify-items: center; gap: 14px; margin-top: 10px; width: 100%; }
  .intro__yes {
    min-height: 72px;
    width: min(100%, 360px);
    padding: 0 30px;
    margin-top: 10px;
    font-size: 1.18rem;
    gap: 14px;
    white-space: nowrap;
    animation: yes-glow 4s ease-in-out infinite;
  }
  .intro__yes-wrap { position: relative; display: grid; justify-items: center; width: 100%; }
  .intro__yes svg { width: 24px; height: 24px; }
  /* "Recommended" sits on the button's top edge like a small seal */
  .intro__badge {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, -50%);
    padding: 5px 12px;
    border-radius: 999px;
    background: linear-gradient(180deg, #fbf4ea, #e6d5bf);
    color: var(--clay-deep);
    box-shadow: inset 0 1px 0 #fff, 0 4px 12px -4px rgb(42 33 27 / 0.45);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow: none;
    pointer-events: none;
  }
  @keyframes yes-glow {
    0%, 100% { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.4), inset 0 -3px 8px rgb(0 0 0 / 0.22), 0 18px 34px -16px rgb(150 85 58 / 0.6), 0 0 0 0 rgb(217 164 127 / 0); }
    50% { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.4), inset 0 -3px 8px rgb(0 0 0 / 0.22), 0 22px 40px -16px rgb(150 85 58 / 0.7), 0 0 0 9px rgb(217 164 127 / 0.2); }
  }
  .intro__no {
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 5px;
    cursor: pointer;
  }
  .intro__no:hover { color: var(--ink); }

  /* the language portal */
  .intro__langs { display: grid; gap: 12px; width: min(100%, 380px); margin-top: 6px; }
  .intro__lang {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 74px;
    padding: 0 22px 0 14px;
    border-radius: 999px;
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .intro__lang:hover { transform: translateY(-2px); }
  .intro__lang:active { transform: scale(0.98); }
  .intro__lang-name { flex: 1; text-align: left; }
  .intro__lang-arrow { width: 20px; height: 20px; opacity: 0.5; transition: transform 0.5s var(--ease), opacity 0.3s; }
  .intro__lang:hover .intro__lang-arrow { transform: translateX(4px); opacity: 1; }
  .intro__flag { position: relative; width: 48px; height: 48px; flex: none; }
  .intro__flag > svg:first-child { width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 0 0 2px rgb(255 255 255 / 0.9), 0 4px 10px -3px rgb(42 33 27 / 0.45); }
  .intro__progress { position: absolute; inset: -6px; width: calc(100% + 12px); height: calc(100% + 12px); transform: rotate(-90deg); fill: none; stroke: var(--clay); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; }
  .intro__lang.is-suggested { box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), 0 0 0 1.5px var(--clay), 0 0 34px -4px rgb(181 112 79 / 0.55), 0 14px 28px -18px rgb(42 33 27 / 0.55); }
  .intro__lang.is-suggested .intro__progress { opacity: 1; }
  .intro__lang.is-suggested::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 26px rgb(217 164 127 / 0.55);
    animation: suggest 2.6s ease-in-out infinite;
    pointer-events: none;
  }
  .intro.is-paused .intro__lang.is-suggested::before { animation-play-state: paused; }
  @keyframes suggest { 50% { opacity: 0.2; } }

  .intro__countdown { display: flex; align-items: center; gap: 12px; width: min(100%, 380px); margin-top: 4px; color: var(--muted); font-size: 0.86rem; }
  .intro__countdown[hidden] { display: none; }
  .intro__seconds {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: var(--clay-deep);
    color: var(--linen);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .intro__countdown-label { flex: 1; text-align: left; }
  .intro__pause { min-height: 44px; padding: 0 6px; border: 0; background: none; color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }

  @media (max-height: 640px) {
    .intro__breath { width: 110px; }
    .intro__text { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro__circle { animation: none; transform: scale(0.82); }
    .intro__ring, .intro__yes, .intro__lang.is-suggested::before { animation: none; }
  }
</style>
