---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../i18n/ui';
import { href } from '../i18n/routes';
import { brand, pillars } from '../data/brand';
import type { Lang } from '../data/site';
import heroPhoto from '../assets/photos/spa-room.jpg';
import herbs from '../assets/photos/herbal-bundles.jpg';
import oilJar from '../assets/photos/oil-jar-linen.jpg';
import candles from '../assets/photos/candles.jpg';
import towels from '../assets/photos/towels-candles.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

// Vision, philosophy and Botanicals follow the client's concept document. The team is a placeholder.
const copy = {
  de: {
    title: 'Über uns',
    description: 'Timeless Spa vereint thailändische Gastfreundschaft und Behandlungskunst mit deutscher Qualität, Präzision und Hygiene. Vision, Philosophie und Timeless Organic Botanicals.',
    eyebrow: 'Über uns',
    h1: 'Thailändisches Herz, <em>deutsche</em> Sorgfalt.',
    lead: 'Timeless Spa ist ein exklusives Wellness- und Ausbildungskonzept: die herzliche Gastfreundschaft und die traditionellen Behandlungstechniken Thailands, verbunden mit deutscher Qualität, Präzision, Hygiene und Professionalität.',
    photoAlt: 'Behandlungsraum mit Liege in warmem Licht',
    visionEyebrow: 'Unsere Vision',
    visionTitle: 'Eine Premium-Wellnessmarke mit <em>Tradition</em>.',
    vision: 'Timeless Spa soll sich als Premium-Wellnessmarke etablieren, die traditionelle Kultur, natürliche Pflege und moderne Spa-Standards vereint: mit exklusiven Behandlungen, eigenen Produktkonzepten und einer professionellen Spa Academy.',
    academyLink: 'Zur Spa Academy',
    philEyebrow: 'Unsere Philosophie',
    botEyebrow: 'Timeless Organic Botanicals',
    botTitle: 'Natürlich, aus <em>Tradition</em>.',
    botText: [
      'Eigene, frisch zubereitete Kräuteraufgüsse und ausgewählte natürliche Pflegeprodukte, inspiriert von thailändischen und deutschen Pflanzentraditionen: Butterfly Pea und Kokos ebenso wie Birke, Brennnessel und Kamille.',
      'Statt pauschal etwas zu versprechen, arbeiten wir mit ausgewählten natürlichen Inhaltsstoffen und transparenten Rezepturen. Auch Naturprodukte können Allergien auslösen. Sagen Sie uns deshalb vorab, worauf Sie empfindlich reagieren. Unsere selbst hergestellten Produkte unterliegen sorgfältiger Hygiene und Haltbarkeitskontrolle.',
    ],
    teamEyebrow: 'Das Team',
    teamTitle: 'Die Hände hinter <em>Timeless</em>.',
    teamText: 'Hier stellen wir bald unser Team vor.',
    member: 'Name folgt',
    role: 'Spa-Therapeut:in',
  },
  en: {
    title: 'About us',
    description: 'Timeless Spa brings together Thai hospitality and the art of touch with German quality, precision and hygiene. Our vision, philosophy and Timeless Organic Botanicals.',
    eyebrow: 'About us',
    h1: 'A Thai heart, <em>German</em> care.',
    lead: 'Timeless Spa is an exclusive wellness and training concept: the warm hospitality and traditional treatment techniques of Thailand, combined with German quality, precision, hygiene and professionalism.',
    photoAlt: 'Treatment room with a table in warm light',
    visionEyebrow: 'Our vision',
    visionTitle: 'A premium wellness brand rooted in <em>tradition</em>.',
    vision: 'Timeless Spa aims to become a premium wellness brand that unites traditional culture, natural care and modern spa standards, with exclusive treatments, its own product concepts and a professional Spa Academy.',
    academyLink: 'To the Spa Academy',
    philEyebrow: 'Our philosophy',
    botEyebrow: 'Timeless Organic Botanicals',
    botTitle: 'Natural, by <em>tradition</em>.',
    botText: [
      'Our own freshly prepared herbal infusions and selected natural care products, inspired by Thai and German plant traditions: butterfly pea and coconut as well as birch, nettle and chamomile.',
      'Rather than making sweeping promises, we work with carefully selected natural ingredients and transparent recipes. Natural products can cause allergies too, so please tell us beforehand what you are sensitive to. The products we make ourselves are subject to careful hygiene and shelf-life checks.',
    ],
    teamEyebrow: 'The team',
    teamTitle: 'The hands behind <em>Timeless</em>.',
    teamText: 'We will introduce our team here soon.',
    member: 'Name to follow',
    role: 'Spa therapist',
  },
}[lang];
---
<Base lang={lang} page="about" title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.h1} lead={copy.lead} photo={heroPhoto} photoAlt={copy.photoAlt} />

  <section class="section vision">
    <div class="wrap vision__grid">
      <div>
        <p class="eyebrow" data-reveal="rise">{copy.visionEyebrow}</p>
        <h2 data-reveal="words" set:html={copy.visionTitle} />
      </div>
      <div data-reveal="rise">
        <p class="lead">{copy.vision}</p>
        <a class="link-arrow" href={href('academy', lang)} data-sfx="click">{copy.academyLink}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section philosophy" data-dust>
    <div class="wrap">
      <p class="eyebrow" data-reveal="rise">{copy.philEyebrow}</p>
      <h2 class="philosophy__claim" data-reveal="words" set:html={brand.claim[lang]} />
      <ul class="philosophy__pillars" data-reveal="stagger">
        {pillars.map((p, i) => (
          <li data-reveal-item>
            <span class="philosophy__num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text[lang]}</p>
          </li>
        ))}
      </ul>
      <p class="philosophy__promise" data-reveal="words">{brand.promise[lang]}</p>
    </div>
  </section>

  <section class="section section--linen space" id="botanicals">
    <div class="wrap space__grid">
      <div class="space__text">
        <p class="eyebrow" data-reveal="rise">{copy.botEyebrow}</p>
        <h2 data-reveal="words" set:html={copy.botTitle} />
        <div data-reveal="rise">
          {copy.botText.map((p) => <p class="lead">{p}</p>)}
        </div>
      </div>
      <div class="space__photos">
        <div class="photo space__a" data-reveal="ripple" data-stone-spot="top-right"><Image src={herbs} alt="" widths={[480, 900]} sizes="(max-width: 900px) 100vw, 34vw" /></div>
        <div class="photo space__b" data-reveal="ripple"><Image src={oilJar} alt="" widths={[400, 700]} sizes="(max-width: 900px) 50vw, 22vw" /></div>
        <div class="photo space__c" data-reveal="ripple"><Image src={candles} alt="" widths={[400, 700]} sizes="(max-width: 900px) 50vw, 22vw" /></div>
      </div>
    </div>
  </section>

  <section class="section team">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal="rise">{copy.teamEyebrow}</p>
        <h2 data-reveal="words" set:html={copy.teamTitle} />
        <p class="lead" data-reveal="rise">{copy.teamText}</p>
      </div>
      <ul class="team__list" data-reveal="stagger">
        {[1, 2, 3].map(() => (
          <li data-reveal-item>
            <div class="team__portrait" aria-hidden="true">
              <svg viewBox="0 0 40 40"><ellipse cx="20" cy="30" rx="11" ry="4.8" fill="currentColor" /><ellipse cx="19.4" cy="21.6" rx="8" ry="3.7" fill="currentColor" transform="rotate(-6 19.4 21.6)" /><ellipse cx="20.6" cy="14.6" rx="5.2" ry="3" fill="currentColor" transform="rotate(5 20.6 14.6)" /></svg>
            </div>
            <h3>{copy.member}</h3>
            <p>{copy.role}</p>
          </li>
        ))}
      </ul>
      <div class="team__cta" data-reveal="rise">
        <button class="btn" type="button" data-book data-sfx="bowl">{t.book}</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .vision__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 90px); align-items: end; }
  .vision .lead { margin-bottom: 24px; }

  .philosophy { background: var(--aubergine); color: rgb(246 241 234 / 0.82); }
  .philosophy .eyebrow { color: var(--gold); }
  .philosophy__claim { max-width: 15ch; color: var(--gold); font-size: clamp(2.3rem, 5vw, 4.4rem); }
  .philosophy__pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 56px); margin: clamp(48px, 7vw, 90px) 0 0; padding: 0; list-style: none; }
  .philosophy__pillars li { padding-top: 26px; border-top: 1px solid rgb(201 178 127 / 0.35); }
  .philosophy__num { display: block; margin-bottom: 22px; font-family: var(--serif); font-style: italic; font-size: 2.6rem; font-weight: 300; line-height: 1; color: var(--gold); }
  .philosophy__pillars h3 { margin-bottom: 12px; color: var(--linen); }
  .philosophy__pillars p { margin: 0; }
  .philosophy__promise { max-width: 26em; margin: clamp(56px, 8vw, 100px) 0 0; font-family: var(--serif); font-style: italic; font-size: clamp(1.4rem, 2.6vw, 2.1rem); line-height: 1.3; color: var(--gold); }

  .space { scroll-margin-top: var(--header-h); }
  .space__grid { display: grid; grid-template-columns: 0.95fr 1.15fr; gap: clamp(40px, 6vw, 90px); align-items: center; }
  .space h2 { margin-bottom: 26px; }
  .space .lead { font-size: 1.08rem; }
  .space__photos { display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; aspect-ratio: 1.15; }
  .space__a { grid-row: 1 / 3; }

  .team__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin: 0; padding: 0; list-style: none; }
  .team__portrait {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: 18px;
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--sand-2), var(--sand-3));
    color: rgb(42 33 27 / 0.18);
  }
  .team__portrait svg { width: 34%; }
  .team__list p { color: var(--muted); }
  .team__cta { display: flex; justify-content: center; margin-top: 40px; }

  @media (max-width: 900px) {
    .vision__grid, .space__grid, .philosophy__pillars { grid-template-columns: 1fr; }
    .team__list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) { .team__list { grid-template-columns: 1fr; } }
</style>
