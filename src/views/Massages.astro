---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MassageCard from '../components/MassageCard.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../i18n/ui';
import { treatments, worldLabels, menuIsSample, type World } from '../data/treatments';
import type { Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const copy = {
  de: {
    title: 'Behandlungen & Preise',
    description: 'Head Spa, Hand & Foot Spa, Thai- und Kräuterstempelmassagen und die Pregnancy Herbal Spa Experience bei Timeless Spa in Köln-Ehrenfeld, mit Dauer und Preisen.',
    eyebrow: 'Erlebniswelten',
    h1: 'Jede Behandlung erzählt eine <em>Geschichte</em>.',
    lead: 'Thailändische Berührungskunst, ausgewählte natürliche Inhaltsstoffe und transparente Rezepturen. Jede Behandlung beginnt mit einem kurzen Gespräch, damit sie zu Ihnen passt.',
    filter: 'Nach Erlebniswelt filtern',
    sample: 'Beispielpreise: Dauer und Preise werden durch das echte Angebot ersetzt.',
    vat: 'Alle Preise inkl. gesetzlicher MwSt. Auch natürliche Inhaltsstoffe können Allergien auslösen: Bitte sagen Sie uns vorab, worauf Sie empfindlich reagieren.',
    unsureTitle: 'Noch unentschlossen?',
    unsureText: 'Erzählen Sie uns, was Sie brauchen, und wir empfehlen Ihnen die passende Behandlung.',
  },
  en: {
    title: 'Treatments & Prices',
    description: 'Head Spa, Hand & Foot Spa, Thai and herbal compress massages and the Pregnancy Herbal Spa Experience at Timeless Spa in Cologne-Ehrenfeld, with durations and prices.',
    eyebrow: 'Experience worlds',
    h1: 'Every treatment tells a <em>story</em>.',
    lead: 'The Thai art of touch, carefully selected natural ingredients and transparent recipes. Every treatment starts with a short chat so it suits you.',
    filter: 'Filter by experience world',
    sample: 'Sample prices: durations and prices will be replaced with the real menu.',
    vat: 'All prices include VAT. Natural ingredients can cause allergies too: please tell us beforehand what you are sensitive to.',
    unsureTitle: 'Still deciding?',
    unsureText: 'Tell us what you need and we will recommend the right treatment.',
  },
}[lang];

const filters: (World | 'all')[] = ['all', 'head', 'handfoot', 'massage', 'pregnancy'];
---
<Base lang={lang} page="massages" title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.h1} lead={copy.lead} />

  <section class="section section--tight menu">
    <div class="wrap">
      {menuIsSample && <p class="menu__sample" role="note">{copy.sample}</p>}
      <div class="menu__filters" role="group" aria-label={copy.filter} data-filters data-reveal="rise">
        {filters.map((f) => (
          <button type="button" class="chip" data-filter={f} aria-pressed={f === 'all' ? 'true' : 'false'}>{worldLabels[f][lang]}</button>
        ))}
      </div>
      <div class="menu__list" data-reveal="stagger" data-menu-list data-stone-spot="top-right">
        {treatments.map((m) => (
          <div id={m.id} class="menu__item" data-reveal-item>
            <MassageCard m={m} lang={lang} />
          </div>
        ))}
      </div>
      <p class="menu__vat">{copy.vat}</p>
    </div>
  </section>

  <section class="section section--dark unsure">
    <div class="wrap unsure__inner">
      <h2 data-reveal="words">{copy.unsureTitle}</h2>
      <p class="lead" data-reveal="rise">{copy.unsureText}</p>
      <div data-reveal="rise">
        <button class="btn btn--light" type="button" data-book data-sfx="bowl"><Icon name="phone" />{t.book}</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .menu { padding-top: 0; }
  .menu__sample {
    margin: 0 0 28px;
    padding: 12px 18px;
    border: 1px dashed var(--clay);
    border-radius: 14px;
    color: var(--clay-deep);
    font-size: 0.92rem;
  }
  .menu__filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 30px; }
  .chip {
    min-height: 44px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.15));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.85), inset 0 0 0 1px rgb(42 33 27 / 0.1), 0 8px 18px -12px rgb(42 33 27 / 0.45);
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.4s var(--ease), color 0.4s var(--ease), box-shadow 0.4s;
  }
  .chip:hover { transform: translateY(-1px); }
  .chip:active { transform: scale(0.96); }
  .chip[aria-pressed='true'] {
    background: radial-gradient(120% 80% at 50% -20%, rgb(255 255 255 / 0.22), transparent 58%), linear-gradient(180deg, #4b3d33, #2a211b 55%, #17110d);
    color: var(--sand);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), inset 0 -3px 6px rgb(0 0 0 / 0.4), 0 10px 20px -10px rgb(42 33 27 / 0.7);
  }
  .menu__filters { padding-block: 6px 14px; }
  .menu__list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .menu__item.is-hidden { display: none; }
  .menu__item { scroll-margin-top: calc(var(--header-h) + 24px); }
  .menu__vat { margin: 28px 0 0; max-width: 60em; color: var(--muted); font-size: 0.9rem; }
  .unsure__inner { display: grid; justify-items: center; text-align: center; }
  .unsure .lead { margin: 20px 0 30px; }
  @media (max-width: 1100px) { .menu__list { grid-template-columns: 1fr; } }
  @media (max-width: 700px) {
    /* phones: the filters become one swipeable row */
    .menu__filters {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .menu__filters::-webkit-scrollbar { display: none; }
  }
</style>
