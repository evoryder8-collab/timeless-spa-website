---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hours from '../components/Hours.astro';
import VoucherCard from '../components/VoucherCard.astro';
import { ui } from '../i18n/ui';
import { href } from '../i18n/routes';
import { brand, pillars, experienceWorlds } from '../data/brand';
import { site, type Lang } from '../data/site';
import heroFallback from '../assets/photos/herbal-compress-back.jpg';
import welcomePhoto from '../assets/photos/back-massage-warm.jpg';
import placePhoto from '../assets/photos/towels-candles.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const copy = {
  de: {
    title: 'Timeless Spa · Thai Heart. German Quality. · Köln-Ehrenfeld',
    description: 'Timeless Spa in Köln-Ehrenfeld: thailändische Heiltradition und deutsche Qualitätsstandards. Head Spa, Hand & Foot Spa, Signature-Massagen, Pregnancy Spa und die Timeless Spa Academy.',
    lead: `${brand.journey.de} Mitten in Köln-Ehrenfeld.`,
    explore: 'Erlebniswelten entdecken',
    touch: 'Berühren Sie das Wasser',
    scroll: 'Scrollen',
    conceptEyebrow: 'Unser Konzept',
    conceptTitle: 'Ein Erlebnis, das in <em>Erinnerung</em> bleibt.',
    conceptText: [
      'Timeless Spa ist ein exklusives Wellness- und Ausbildungskonzept, das die herzliche Gastfreundschaft und die traditionellen Behandlungstechniken Thailands mit deutscher Qualität, Präzision, Hygiene und Professionalität verbindet.',
      'Unser Ziel ist es, nicht einfach eine Behandlung anzubieten, sondern ein Erlebnis zu schaffen, das in Erinnerung bleibt.',
    ],
    about: 'Über uns',
    philEyebrow: 'Unsere Philosophie',
    worldsEyebrow: 'Unsere Erlebniswelten',
    worldsTitle: 'Sechs Wege, die Zeit <em>anzuhalten</em>.',
    worldsAll: 'Alle Behandlungen & Preise',
    discover: 'Entdecken',
    voucherEyebrow: 'Gutscheine',
    voucherTitle: 'Verschenken Sie <em>Zeit</em>.',
    voucherText: 'Ein Gutschein über einen Wunschbetrag oder eine bestimmte Behandlung, etwa ein Head Spa Ritual. Erhältlich vor Ort, per Telefon oder per WhatsApp.',
    voucherCta: 'Mehr zu Gutscheinen',
    findEyebrow: 'Hier finden Sie uns',
    findTitle: 'Am Melatengürtel, <em>mitten in Ehrenfeld</em>.',
    findCta: 'Anfahrt & Kontakt',
    endText: 'Rufen Sie an oder schreiben Sie uns. Wir freuen uns auf Sie.',
  },
  en: {
    title: 'Timeless Spa · Thai Heart. German Quality. · Cologne-Ehrenfeld',
    description: 'Timeless Spa in Cologne-Ehrenfeld: Thai healing traditions and German quality standards. Head Spa, Hand & Foot Spa, signature massages, pregnancy spa and the Timeless Spa Academy.',
    lead: `${brand.journey.en} In the heart of Cologne-Ehrenfeld.`,
    explore: 'Explore our worlds',
    touch: 'Touch the water',
    scroll: 'Scroll',
    conceptEyebrow: 'Our concept',
    conceptTitle: 'An experience that <em>stays with you</em>.',
    conceptText: [
      'Timeless Spa is an exclusive wellness and training concept that brings together the warm hospitality and traditional treatment techniques of Thailand with German quality, precision, hygiene and professionalism.',
      'Our aim is not simply to offer a treatment, but to create an experience you will remember.',
    ],
    about: 'About us',
    philEyebrow: 'Our philosophy',
    worldsEyebrow: 'Our experience worlds',
    worldsTitle: 'Six ways to <em>stop the clock</em>.',
    worldsAll: 'All treatments & prices',
    discover: 'Discover',
    voucherEyebrow: 'Gift vouchers',
    voucherTitle: 'Give the gift of <em>time</em>.',
    voucherText: 'A voucher for any amount or for a specific treatment, such as a Head Spa ritual. Available in person, by phone or on WhatsApp.',
    voucherCta: 'More about vouchers',
    findEyebrow: 'Find us',
    findTitle: 'On the Melatengürtel, <em>in the heart of Ehrenfeld</em>.',
    findCta: 'Directions & contact',
    endText: 'Call us or send us a message. We look forward to seeing you.',
  },
}[lang];

const worldHref = (w: (typeof experienceWorlds)[number]) => href(w.page, lang) + (w.hash ? `#${w.hash}` : '');
---
<Base lang={lang} page="home" title={copy.title} description={copy.description}>
  <section class="hero" data-hero>
    <div class="hero__stage" data-hero-stage aria-hidden="true">
      <Image class="hero__fallback" src={heroFallback} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="wrap hero__content">
      <p class="eyebrow" data-reveal="rise">{brand.tagline}</p>
      <h1 data-reveal="words" set:html={brand.claim[lang]} />
      <p class="lead" data-reveal="rise">{copy.lead}</p>
      <div class="hero__ctas" data-reveal="rise">
        <button class="btn" type="button" data-book data-sfx="bowl">{t.book}</button>
        <a class="btn btn--ghost" href={href('massages', lang)} data-sfx="click">{copy.explore}<Icon name="arrow" /></a>
      </div>
    </div>
    <p class="hero__touch" data-hero-touch>{copy.touch}</p>
    <div class="hero__scroll" aria-hidden="true"><span>{copy.scroll}</span><i></i></div>
  </section>

  <section class="section welcome">
    <div class="wrap welcome__grid">
      <div class="welcome__text">
        <p class="eyebrow" data-reveal="rise">{copy.conceptEyebrow}</p>
        <h2 data-reveal="words" set:html={copy.conceptTitle} />
        <div data-reveal="rise">
          {copy.conceptText.map((p) => <p class="lead">{p}</p>)}
          <a class="link-arrow" href={href('about', lang)} data-sfx="click">{copy.about}<Icon name="arrow" /></a>
        </div>
      </div>
      <div class="photo welcome__photo" data-reveal="ripple" data-stone-spot="top-left">
        <Image src={welcomePhoto} alt={lang === 'de' ? 'Hände massieren einen Rücken' : 'Hands massaging a back'} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
      </div>
    </div>
  </section>

  <section class="section philosophy">
    <div class="wrap">
      <p class="eyebrow" data-reveal="rise">{copy.philEyebrow}</p>
      <h2 class="philosophy__claim" data-reveal="words" set:html={brand.claim[lang]} />
      <ul class="philosophy__pillars" data-reveal="stagger">
        {pillars.map((p, i) => (
          <li data-reveal-item>
            <span class="philosophy__num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text[lang]}</p>
          </li>
        ))}
      </ul>
      <p class="philosophy__promise" data-reveal="words">{brand.promise[lang]}</p>
    </div>
  </section>

  <section class="section section--linen signature">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal="rise">{copy.worldsEyebrow}</p>
        <h2 data-reveal="words" set:html={copy.worldsTitle} />
      </div>
      <div class="signature__grid" data-reveal="stagger" data-carousel>
        {experienceWorlds.map((w, i) => (
          <a class="sig" href={worldHref(w)} data-tilt data-stone-hover data-warm={w.warm ? '' : undefined} data-sfx="click" data-reveal-item>
            <div class="sig__photo">
              <Image src={w.photo} alt="" widths={[400, 700]} sizes="(max-width: 800px) 80vw, 30vw" />
              <span class="sig__num">{i + 1}</span>
            </div>
            <div class="sig__body">
              <h3>{w.name[lang]}</h3>
              <p>{w.text[lang]}</p>
              <span class="sig__meta">{copy.discover}<Icon name="arrow" /></span>
            </div>
          </a>
        ))}
      </div>
      <div class="signature__all" data-reveal="rise">
        <a class="btn btn--ghost" href={href('massages', lang)} data-sfx="click">{copy.worldsAll}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--dark gift">
    <div class="wrap gift__grid">
      <div>
        <p class="eyebrow" data-reveal="rise">{copy.voucherEyebrow}</p>
        <h2 data-reveal="words" set:html={copy.voucherTitle} />
        <p class="lead" data-reveal="rise">{copy.voucherText}</p>
        <div data-reveal="rise">
          <a class="btn btn--light" href={href('vouchers', lang)} data-sfx="click"><Icon name="gift" />{copy.voucherCta}</a>
        </div>
      </div>
      <div data-reveal="rise">
        <VoucherCard lang={lang} size="small" />
      </div>
    </div>
  </section>

  <section class="section find">
    <div class="wrap find__grid">
      <div class="photo find__photo" data-reveal="ripple" data-stone-spot="top-right">
        <Image src={placePhoto} alt={lang === 'de' ? 'Gerollte Handtücher und Kerzen' : 'Rolled towels and candles'} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
      </div>
      <div>
        <p class="eyebrow" data-reveal="rise">{copy.findEyebrow}</p>
        <h2 data-reveal="words" set:html={copy.findTitle} />
        <div class="find__info" data-reveal="rise">
          <p class="find__address"><Icon name="pin" />{site.address.street}<br />{site.address.zip} {site.address.city}-{site.address.district}</p>
          <Hours lang={lang} />
          <a class="link-arrow" href={href('contact', lang)} data-sfx="click">{copy.findCta}<Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--linen end">
    <div class="wrap end__inner">
      <h2 data-reveal="words">{brand.promise[lang]}</h2>
      <p class="lead" data-reveal="rise">{copy.endText}</p>
      <div class="end__ctas" data-reveal="rise">
        <button class="btn" type="button" data-book data-sfx="bowl">{t.book}</button>
        <a class="btn btn--ghost" href={site.phone.href}><Icon name="phone" />{site.phone.display}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ───── hero ───── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: linear-gradient(180deg, #efe3d3 0%, #e8cdb5 58%, #c9a184 100%);
  }
  .hero__stage { position: absolute; inset: 0; }
  .hero__stage :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.25) saturate(0.85) brightness(1.04);
    transition: opacity 1.2s var(--ease);
  }
  .hero.has-webgl .hero__fallback { opacity: 0; }
  .hero__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(237 228 216 / 0.88) 0%, rgb(237 228 216 / 0.55) 38%, transparent 66%),
      linear-gradient(0deg, rgb(237 228 216 / 0.7) 0%, transparent 34%);
  }
  .hero.has-webgl .hero__veil {
    background:
      linear-gradient(90deg, rgb(239 227 211 / 0.72) 0%, rgb(239 227 211 / 0.25) 36%, transparent 58%),
      linear-gradient(0deg, rgb(237 228 216 / 0.55) 0%, transparent 26%);
  }
  .hero__content {
    position: relative;
    padding-top: calc(var(--header-h) + 60px);
    padding-bottom: clamp(110px, 16vh, 170px);
    pointer-events: none;
  }
  .hero__content > * { pointer-events: auto; }
  .hero h1 { max-width: 11ch; font-size: clamp(2.6rem, 6.2vw, 5.8rem); }
  /* a soft halo of light behind the hero text, so it always reads against the water and the stones */
  .hero h1, .hero .eyebrow, .hero .lead {
    text-shadow: 0 0 2px rgb(244 234 220 / 0.9), 0 0 18px rgb(244 234 220 / 0.85), 0 0 44px rgb(244 234 220 / 0.7);
  }
  .hero .lead { margin-top: 26px; max-width: 26em; color: var(--espresso-2); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hero__touch {
    position: absolute;
    right: var(--gutter);
    bottom: 44px;
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    color: var(--espresso-2);
    opacity: 0;
    transition: opacity 1s;
    pointer-events: none;
  }
  .hero.has-webgl .hero__touch { opacity: 0.75; }
  .hero.touched .hero__touch { opacity: 0; }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    display: grid;
    justify-items: center;
    gap: 10px;
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--espresso-2);
    pointer-events: none;
  }
  .hero__scroll i { position: relative; width: 1px; height: 46px; overflow: hidden; background: rgb(42 33 27 / 0.18); }
  .hero__scroll i::after {
    content: '';
    position: absolute;
    left: 0;
    top: -50%;
    width: 1px;
    height: 50%;
    background: var(--espresso);
    animation: drip 2.4s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  @keyframes drip { to { top: 110%; } }
  @media (max-width: 980px) {
    /* phones: the scene keeps the top of the screen to itself and the text starts below it */
    .hero { align-items: start; }
    .hero__content {
      padding-top: max(calc(var(--header-h) + 30svh), 300px);
      padding-bottom: 64px;
    }
    .hero__touch {
      left: 0;
      right: 0;
      top: calc(var(--header-h) + 6px);
      bottom: auto;
      text-align: center;
      font-size: 0.95rem;
    }
    .hero__touch::after {
      /* a ring that keeps inviting a tap until the water has been touched */
      content: '';
      display: block;
      width: 34px;
      height: 34px;
      margin: 10px auto 0;
      border-radius: 50%;
      border: 1.5px solid currentColor;
      animation: invite 2.2s ease-out infinite;
    }
    @keyframes invite { from { transform: scale(0.4); opacity: 0.9; } to { transform: scale(1.6); opacity: 0; } }
    .hero__scroll { display: none; }
    .hero__veil, .hero.has-webgl .hero__veil {
      background: linear-gradient(0deg, rgb(237 228 216 / 0.94) 0%, rgb(237 228 216 / 0.75) 42%, transparent 72%);
    }
  }

  /* ───── welcome ───── */
  .welcome__grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(40px, 7vw, 110px); align-items: center; }
  .welcome h2 { margin-bottom: 30px; }
  .welcome .lead { margin-bottom: 1.1em; }
  .welcome__photo { aspect-ratio: 4 / 5; }

  /* ───── signature ───── */
  .signature__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .sig {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--sand);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.8s var(--ease), box-shadow 0.8s var(--ease);
  }
  .sig:hover { transform: translateY(-6px); box-shadow: 0 40px 70px -40px rgb(42 33 27 / 0.55); }
  .sig__photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sand-2); }
  .sig__num {
    position: absolute;
    left: 16px;
    top: 14px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--linen);
    text-shadow: 0 2px 18px rgb(42 33 27 / 0.6);
  }
  .sig__photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .sig:hover .sig__photo :global(img) { transform: scale(1.06); }
  .sig__body { display: flex; flex-direction: column; flex: 1; padding: 26px 26px 24px; }
  .sig__body h3 { margin-bottom: 10px; }
  .sig__body p { color: var(--muted); font-size: 0.98rem; }
  .sig__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.93rem;
  }
  .sig__meta :global(svg) { width: 18px; height: 18px; transition: transform 0.5s var(--ease); }
  .sig:hover .sig__meta :global(svg) { transform: translateX(5px); }
  .signature__all { margin-top: 44px; display: flex; justify-content: center; }

  /* ───── philosophy: the concept's own colours, deep aubergine and champagne gold ───── */
  .philosophy { background: var(--aubergine); color: rgb(246 241 234 / 0.82); }
  .philosophy .eyebrow { color: var(--gold); }
  .philosophy__claim { max-width: 15ch; color: var(--gold); font-size: clamp(2.3rem, 5vw, 4.4rem); }
  .philosophy__claim :global(em) { color: var(--linen); }
  .philosophy__pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 56px); margin: clamp(48px, 7vw, 90px) 0 0; padding: 0; list-style: none; }
  .philosophy__pillars li { padding-top: 26px; border-top: 1px solid rgb(201 178 127 / 0.35); }
  .philosophy__num { display: block; margin-bottom: 22px; font-family: var(--serif); font-style: italic; font-size: 2.6rem; font-weight: 300; line-height: 1; color: var(--gold); }
  .philosophy__pillars h3 { margin-bottom: 12px; color: var(--linen); }
  .philosophy__pillars p { margin: 0; }
  .philosophy__promise {
    max-width: 26em;
    margin: clamp(56px, 8vw, 100px) 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.3;
    color: var(--gold);
  }

  /* ───── voucher teaser ───── */
  .gift__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 100px); align-items: center; }
  .gift h2 { margin-bottom: 26px; }
  .gift .lead { margin-bottom: 32px; }

  /* ───── find us ───── */
  .find__grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(40px, 7vw, 110px); align-items: center; }
  .find__photo { aspect-ratio: 5 / 6; }
  .find h2 { margin-bottom: 34px; }
  .find__info { display: grid; gap: 22px; max-width: 460px; }
  .find__address { display: flex; gap: 12px; margin: 0; font-size: 1.1rem; }
  .find__address :global(svg) { width: 22px; height: 22px; flex: none; margin-top: 3px; color: var(--clay-deep); }
  .find__info .link-arrow { justify-self: start; }

  /* ───── end ───── */
  .end__inner { display: grid; justify-items: center; text-align: center; }
  .end h2 { max-width: 18ch; }
  .end .lead { margin: 22px 0 34px; }
  .end__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  @media (max-width: 900px) {
    .welcome__grid, .gift__grid, .find__grid { grid-template-columns: 1fr; }
    .welcome__photo, .find__photo { aspect-ratio: 4 / 3; }
    .philosophy__pillars { grid-template-columns: 1fr; }
    /* phones: the signature massages become a swipeable row; the card in the middle comes forward */
    .signature__grid {
      display: flex;
      gap: 14px;
      margin-inline: calc(-1 * var(--gutter));
      padding: 10px var(--gutter) 24px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .signature__grid::-webkit-scrollbar { display: none; }
    /* `scale` and the children's opacity, so the scroll reveal (transform, opacity on the card) never fights it */
    .sig {
      --focus: 1;
      flex: 0 0 80%;
      scroll-snap-align: center;
      scale: calc(0.9 + 0.1 * var(--focus));
      transition: scale 0.25s ease-out, box-shadow 0.8s var(--ease);
    }
    .sig > * { opacity: calc(0.5 + 0.5 * var(--focus)); transition: opacity 0.25s ease-out; }
  }
</style>
