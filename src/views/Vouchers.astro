---
import Base from '../layouts/Base.astro';
import VoucherCard from '../components/VoucherCard.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../i18n/ui';
import { site, mailto, whatsappWith, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const copy = {
  de: {
    title: 'Gutscheine',
    description: 'Gutscheine von Timeless Spa in Köln-Ehrenfeld: Wunschbetrag oder bestimmte Behandlung, erhältlich vor Ort, per Telefon oder WhatsApp.',
    eyebrow: 'Gutscheine',
    h1: 'Verschenken Sie <em>Zeit</em>.',
    lead: 'Eine Behandlung ist eines der wenigen Geschenke, die man nicht ins Regal stellt. Wählen Sie einen Betrag oder eine bestimmte Erlebniswelt, den Rest erledigen wir.',
    howEyebrow: 'So funktioniert es',
    howTitle: 'In drei Schritten zum <em>Gutschein</em>.',
    steps: [
      ['Auswählen', 'Einen Wunschbetrag oder eine bestimmte Behandlung, zum Beispiel ein Head Spa Ritual oder eine Kräuterstempel-Massage.'],
      ['Bestellen', 'Rufen Sie an, schreiben Sie uns per WhatsApp oder E-Mail, oder kommen Sie vorbei.'],
      ['Verschenken', 'Wir besprechen mit Ihnen, wie Sie den Gutschein erhalten, damit er rechtzeitig ankommt.'],
    ],
    orderTitle: 'Gutschein bestellen',
    whatsappText: 'Hallo Timeless Spa, ich möchte gerne einen Gutschein bestellen.',
    emailSubject: 'Gutschein-Bestellung',
  },
  en: {
    title: 'Gift vouchers',
    description: 'Gift vouchers from Timeless Spa in Cologne-Ehrenfeld: any amount or a specific treatment, available in person, by phone or on WhatsApp.',
    eyebrow: 'Gift vouchers',
    h1: 'Give the gift of <em>time</em>.',
    lead: 'A treatment is one of the few gifts that never ends up on a shelf. Choose an amount or a specific experience and we take care of the rest.',
    howEyebrow: 'How it works',
    howTitle: 'Your voucher in <em>three steps</em>.',
    steps: [
      ['Choose', 'Any amount, or a specific treatment such as a Head Spa ritual or a herbal compress massage.'],
      ['Order', 'Call us, message us on WhatsApp or by email, or drop by.'],
      ['Give', 'We agree with you how you receive the voucher, so it arrives in time.'],
    ],
    orderTitle: 'Order a voucher',
    whatsappText: 'Hello Timeless Spa, I would like to order a gift voucher.',
    emailSubject: 'Gift voucher order',
  },
}[lang];
---
<Base lang={lang} page="vouchers" title={copy.title} description={copy.description}>
  <section class="page-hero vhero">
    <div class="wrap vhero__grid">
      <div>
        <p class="eyebrow" data-reveal="rise">{copy.eyebrow}</p>
        <h1 data-reveal="words" set:html={copy.h1} />
        <p class="lead" data-reveal="rise">{copy.lead}</p>
      </div>
      <div class="vhero__card" data-reveal="rise">
        <VoucherCard lang={lang} />
      </div>
    </div>
  </section>

  <section class="section section--linen how">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal="rise">{copy.howEyebrow}</p>
        <h2 data-reveal="words" set:html={copy.howTitle} />
      </div>
      <ol class="how__steps" data-reveal="stagger">
        {copy.steps.map(([title, text], i) => (
          <li data-reveal-item>
            <span class="how__num">{i + 1}</span>
            <div><h3>{title}</h3><p>{text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--dark order" data-dust>
    <div class="wrap order__inner">
      <h2 data-reveal="words">{copy.orderTitle}</h2>
      <div class="order__options" data-reveal="stagger">
        <a class="order__option" href={site.phone.href} data-sfx="bowl" data-reveal-item>
          <Icon name="phone" /><span><strong>{t.booking.call}</strong>{site.phone.display}</span>
        </a>
        <a class="order__option" href={whatsappWith(copy.whatsappText)} target="_blank" rel="noopener" data-sfx="bowl" data-reveal-item>
          <Icon name="whatsapp" /><span><strong>WhatsApp</strong>{site.whatsapp.display}</span>
        </a>
        <a class="order__option" href={mailto(copy.emailSubject)} data-sfx="bowl" data-reveal-item>
          <Icon name="mail" /><span><strong>{t.booking.email}</strong>{site.email}</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .vhero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 90px); align-items: center; }
  .vhero .lead { margin-top: 28px; }
  .vhero__card { padding: 40px 0; }

  .how__steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin: 0; padding: 0; list-style: none; }
  .how__steps li { display: grid; gap: 22px; padding: 32px; border-radius: var(--radius); background: var(--sand); }
  .how__num {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--clay-deep);
    color: var(--linen);
    font-family: var(--serif);
    font-size: 1.4rem;
  }
  .how__steps h3 { margin-bottom: 10px; }
  .how__steps p { margin: 0; color: var(--muted); }

  .order__inner { display: grid; justify-items: center; gap: 40px; text-align: center; }
  .order__options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; width: 100%; max-width: 980px; }
  .order__option {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px;
    border-radius: 20px;
    background: rgb(237 228 216 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(237 228 216 / 0.14);
    text-align: left;
    text-decoration: none;
    transition: background-color 0.4s, transform 0.6s var(--ease);
  }
  .order__option:hover { background: rgb(237 228 216 / 0.13); transform: translateY(-3px); }
  .order__option :global(svg) { width: 26px; height: 26px; flex: none; color: var(--clay-soft); }
  .order__option strong { display: block; color: var(--linen); }
  .order__option span { color: rgb(237 228 216 / 0.72); font-size: 0.93rem; overflow-wrap: anywhere; }

  @media (max-width: 900px) {
    .vhero__grid, .how__steps, .order__options { grid-template-columns: 1fr; }
  }
</style>
